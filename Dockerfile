# ==========================================
# ENTERPRISE-СПЕЦИФИКАЦИЯ СБОРКИ: Dockerfile
# ==========================================

# 1. Используем официальный стабильный и легковесный образ Linux с Python
FROM python:3.11-slim

# 2. Настраиваем рабочую директорию внутри изолированного контейнера
WORKDIR /app

# 3. Создаем выделенную папку для монтирования внешних данных (SQLite, JSON и логов)
RUN mkdir -p /app/data

# 4. Устанавливаем официальный SDK Anthropic MCP новейшего стандарта v2.x
RUN pip install --no-cache-dir "mcp>=2.0.0"

# 5. Копируем наше производственное ядро сервера внутрь контейнера
COPY server.py .

# 6. Отключаем буферизацию вывода для мгновенного обмена пакетами по stdio
ENV PYTHONUNBUFFERED=1

# 7. Назначаем точку входа при старте контейнера
ENTRYPOINT ["python", "server.py"]
